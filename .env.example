# =============================================================================
# RAG Benchmark Lab configuration. Copy to `.env` and adjust.
# Every model, endpoint and API key is configured here, never in code.
# =============================================================================

# --- PostgreSQL + pgvector ---------------------------------------------------
POSTGRES_USER=rag
# Required: Compose refuses to start without it. Change it for any shared host.
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_lab
# Inside Docker Compose the host is `db`; from your machine use `localhost`.
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag_lab

# --- Chat LLM (any OpenAI-compatible API) ------------------------------------
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Ollama:      http://ollama:11434/v1   (or http://host.docker.internal:11434/v1)
# llama.cpp:   http://llamacpp:8080/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=changeme
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60

# --- Embeddings (any OpenAI-compatible /embeddings API) ----------------------
# A collection is bound to the embedding model and dimension used to index it.
# Changing them requires re-indexing (or a new collection).
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=changeme
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64

# --- Reranker ----------------------------------------------------------------
# local: Sentence Transformers cross-encoder running inside the API container.
# api:   HTTP /rerank endpoint (Jina/Cohere-style, llama.cpp, vLLM, TEI).
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BASE_URL=
RERANKER_API_KEY=

# --- Ingestion ---------------------------------------------------------------
MAX_UPLOAD_MB=25
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120

# --- UI ----------------------------------------------------------------------
# URL the Streamlit UI uses to reach the API.
API_URL=http://api:8000
